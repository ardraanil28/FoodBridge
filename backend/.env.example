# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Configuration (Defaults to local SQLite database in backend/data/foodbridge.db)
DATABASE_PATH=

# Supabase / PostgreSQL Database Connection (Optional if deploying to Supabase PostgreSQL)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google Gemini API Key (Official @google/genai SDK)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
